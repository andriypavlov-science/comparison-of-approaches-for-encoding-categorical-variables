% Dataset used in the tabular data benchmark https://github.com/LeoGrin/tabular-benchmark,  
%                           transformed in the same way. This dataset belongs to the "classification on categorical and
%                           numerical features" benchmark. Original description: 
%  
% Data reported to the police about the circumstances of personal injury road accidents in Great Britain from 1979, and the maker and model information of vehicles involved in the respective accident.
%
% This version includes data up to 2015.
@RELATION road-safety

@ATTRIBUTE Vehicle_Reference_df_res REAL
@ATTRIBUTE Vehicle_Type REAL
@ATTRIBUTE Vehicle_Manoeuvre REAL
@ATTRIBUTE Vehicle_Location-Restricted_Lane REAL
@ATTRIBUTE Hit_Object_in_Carriageway REAL
@ATTRIBUTE Hit_Object_off_Carriageway REAL
@ATTRIBUTE Was_Vehicle_Left_Hand_Drive? {1.0, 2.0}
@ATTRIBUTE Age_of_Driver REAL
@ATTRIBUTE Age_Band_of_Driver REAL
@ATTRIBUTE Engine_Capacity_(CC) REAL
@ATTRIBUTE Propulsion_Code REAL
@ATTRIBUTE Age_of_Vehicle REAL
@ATTRIBUTE Location_Easting_OSGR REAL
@ATTRIBUTE Location_Northing_OSGR REAL
@ATTRIBUTE Longitude REAL
@ATTRIBUTE Latitude REAL
@ATTRIBUTE Police_Force REAL
@ATTRIBUTE Number_of_Vehicles REAL
@ATTRIBUTE Number_of_Casualties REAL
@ATTRIBUTE Local_Authority_(District) REAL
@ATTRIBUTE 1st_Road_Number REAL
@ATTRIBUTE 2nd_Road_Number REAL
@ATTRIBUTE Urban_or_Rural_Area {1.0, 2.0}
@ATTRIBUTE Vehicle_Reference_df REAL
@ATTRIBUTE Casualty_Reference REAL
@ATTRIBUTE Sex_of_Casualty {1.0, 2.0}
@ATTRIBUTE Age_of_Casualty REAL
@ATTRIBUTE Age_Band_of_Casualty REAL
@ATTRIBUTE Pedestrian_Location REAL
@ATTRIBUTE Pedestrian_Movement REAL
@ATTRIBUTE Casualty_Type REAL
@ATTRIBUTE Casualty_IMD_Decile REAL
@ATTRIBUTE Sex_of_Driver {1.0, 2.0}

